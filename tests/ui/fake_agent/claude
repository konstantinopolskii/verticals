#!/usr/bin/env python3
"""A stand-in for `claude --print --input-format stream-json` in the UI suite: no model, no network. It answers each message by
marks in its words: `[tool:NAME]` shows Verticals' tool NAME at work, `[tool:NAME {"id": "X"}]` really calls it (over MCP, the
way Claude does, with the connection the gateway wrote for this conversation: `--mcp-config`), `[ask]` asks permission first,
`[ask:NAME]` asks permission for one of the writes in ASKS, shaped as the real tool is called, `[make:ID|Title]` makes the
goal ID by calling `create` and gets the words Verticals' server answers it with, `[slow]` works for a second and a half,
`[wait:N]` works for N seconds, `[long]` answers in three paragraphs, `[fail]` ends the turn with an error, `[say]` answers
with the words after it, and `[context]` with the app context Verticals sent. `[question]` says what the board holds,
then asks Claude's question tool (AskUserQuestion) the two questions of QUESTION, as the CLI asks its host for it, and answers
with the answers it got back, the way the tool's result reads them ("question"="answer"). A message that opens with "Check
again" (a document's comments and edits handed over, web/src/lib/checkAgain.ts) works for a second and a half, which is the time a test
has to rewrite the document as the real agent would, then answers in two lines. A message that opens with "Improve it" (a
report's design asked for, web/src/lib/reportActions.ts) is answered as the real agent answers it through Verticals' tools: it
writes a design document into the report's task, linked to it, and says it is waiting for the person's comments; this one
reaches the API the tests' gateway was started with (FAKE_AGENT_API). A message that opens with "A person's report, in their
words" (a report to sort and name, desktop/chat/report_kind.py) is answered as the real agent answers it: two lines, the kind
(request when the words say what the person would like: "I'd like", "would be nice", "I wish", "I want", "could be", "should
be", "please add"; bug otherwise) and the task's name by its result, for the two sample wordings the tests use ("A card
dragged to Friday stays there", "A card dropped near Friday snaps to it"). `[nameless]` in the words leaves the second line
out, and `[unclear]` answers with a sentence that names neither kind. Each start appends the arguments it was given to
`argv.log` in its folder, so a scenario can read what the gateway really asked of the CLI (its mode, tools and instructions),
and every message it is sent, whole, to `received.log` beside it.

The morning report (docs/design/morning-quality.md) is played when `scenario.json` in the same folder says `"morning": true`:
the seat the gateway started it in (the writer, or the second agent that checks the report) does what that seat does against
the real server, as `fake_morning.py` says. Without the file, a morning ask is answered like any other message.

Like the CLI, it asks its host before it calls a tool that an `ask` rule on its command line matches (`--settings`, as the
morning turns are started with `permissions.ask`: every MCP tool), whatever `--allowedTools` says; the rule wins, as the
docs say. The host answers allow or deny, a denied call gets an error result, and each answer is appended to `decisions.log`.
`writer_tools` and `checker_tools` in the scenario name tools that seat tries once, besides the ones its work calls.

Signing in (docs/design/agent-sign-in.md): `fake-auth.json` in the agent's home (`CLAUDE_CONFIG_DIR`) says this Mac's Claude Code
is signed out, `{"signedOut": true}`; without the file, or without that folder, it is signed in. Signed out, every message ends
in the error the real CLI gave when its sign-in had expired; `[authfail]` ends in the same words while it is signed in.
`claude auth status` prints `loggedIn` as JSON, and exits 1 when signed out. `claude auth login` prints the sign-in page's
address and waits, its stdin open, until a test signs it in by writing the file again; `"login": "exit"` in the file ends it
at once without a sign-in, `"login": "silent"` waits without the address. Each `auth` call appends its arguments, the
`CLAUDE_CONFIG_DIR` it saw and its pid to `auth.log` in its folder."""
import fnmatch
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request

import fake_morning


def out(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def read():
    line = sys.stdin.readline()
    return json.loads(line) if line.strip() else None


CHECKED = "Check again"
IMPROVE = "Improve it"
SORT = "A person's report, in their words"
WISHES = ("i'd like", "i would like", "would be nice", "i wish", "i want", "could be", "should be", "please add")
# The task's name by its result, for the sample wordings of the report tests: what the real agent would call each.
NAMES = (("dragged the card to friday and it jumped back", "A card dragged to Friday stays there"),
         ("snap to friday when i drop it near it", "A card dropped near Friday snaps to it"))

