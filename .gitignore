# Zone 1 personal material — never enters a commit. seed/ has its own .gitignore; this
# root entry is belt-and-braces so a `git add -A` from the repo root cannot pull it in.
/seed/

# The sanitizer's personal-term denylist. A list naming a real person's name, clients and
# medication is identifying material in its own right, and tools/uiref/ ships in the
# open-source split. sanitize.mjs runs its structural checks without it and says so loudly.
tools/uiref/leakwords.local.txt

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node / frontend build
node_modules
dist/
storybook-static/
.vite/

# Test harness output and capture artefacts — regenerated every run, never authored
artifacts/
tests/fixtures/gen_corpus_output/

# Postgres data volumes if ever bind-mounted locally
pgdata/

# Backups. `make backup` writes ./verticals-backup.dump by default (README, "Backing up and
# restoring"); `.part` is the same file mid-write, before it has been verified and renamed.
# A dump of a real database is that database — every goal title and body in it — so it is Zone 1
# by construction and can never be committed, whatever it is named.
*.dump
*.dump.part

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# vue-tsc incremental build state — regenerated by `npm run typecheck`, never authored
web/tsconfig.tsbuildinfo

# WP-17 demo screenshots — regenerable by `node tools/wp17-demo/verify.mjs` against the dev
# server, and the whole tools/wp17-demo/ tree is scaffolding WP-22 deletes. The scripts are
# worth versioning; their output is not.
tools/wp17-demo/shots/

# Repository-owned portable skills live in `.agents/skills/`. Claude discovers these relative
# links; Codex reads the source directories directly.
.claude/skills/*
!.claude/skills/verticals-planning
!.claude/skills/verticals-operator
!.claude/skills/verticals-morning-report
!.claude/skills/verticals-pr
web/.claude/skills/

# Parity measurement recordings + Luna browser profile — owner-account material, this Mac only
/measure/

# Native local launcher: database, credentials, logs. Never publish.
/.local-verticals/

# Desktop app (desktop/README.md): token-free UI build and the launcher's local state.
/desktop/build/
/.local-verticals-desktop/
