# Verticals — environment contract. Frozen in docs/IMPLEMENTATION.md §6.3.
# Do not add variables here without updating that section first: this file and the section
# must always agree, since S-113 asserts the placeholder token below never authenticates.
#
# Copy to .env and fill in the two required values. Everything else has a working default.

# Full libpq URL. No host/port/user split — one string, one parse. Required, no default.
VERTICALS_DATABASE_URL=postgresql://verticals:verticals@127.0.0.1:55432/verticals

# The whole auth system. Boot fails if unset, empty, or equal to this placeholder.
# The process never generates one — the container entrypoint does, on first run only,
# mode 0600, printed once. Required, no default.
VERTICALS_TOKEN=REPLACE_ME_THIS_VALUE_NEVER_AUTHENTICATES

# The single owner today. core/ never defaults this — only the transport reads it.
VERTICALS_OWNER=local

# HTTP transport bind address. Loopback by default.
VERTICALS_BIND=127.0.0.1:8080

# MCP streamable-http transport bind address. Separate from VERTICALS_BIND because the two
# transports are separate processes. Ignored entirely by the stdio MCP transport.
VERTICALS_MCP_BIND=127.0.0.1:8081

# Connection pool bounds. AC-079 asserts these exact default values.
VERTICALS_POOL_MIN=2
VERTICALS_POOL_MAX=10

# Structured single-line logs. The token never appears in one.
VERTICALS_LOG_LEVEL=info
